{
  "manifest_version": 2,
  "name": "ScanCheck",
  "version": "1.0",
  "description": "Scans websites for phishing and suspicious activity.",

  "permissions": [
    "activeTab",
    "tabs",
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ]
}
